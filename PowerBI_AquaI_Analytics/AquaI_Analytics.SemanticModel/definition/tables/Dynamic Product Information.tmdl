				    ("Pack Size", NAMEOF('Dim_Product'[PackSize]), 9),
				    ("CBM", NAMEOF('Dim_Product'[CBM]), 10),
				    ("Growth Factor", NAMEOF('Dim_Product'[GrowthFactor]), 11),
				    ("Required Months Stock", NAMEOF([Required Months Stock]), 12),
				    ("Ideal Stocking Level", NAMEOF([Ideal Stocking Level]), 13),
				    ("Current Space Requirements CBM", NAMEOF([Current Space Requirements CBM]), 14),
				    ("Ideal Space Requirements", NAMEOF([Ideal Space Requirements]), 15),
				    ("Monthly AVG Sales QTY (6 months)", NAMEOF([Monthly Average Sales for 6 month period]), 16),
