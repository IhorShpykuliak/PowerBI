	partition Dim_Product = m
		mode: import
		source =
				let
				    Source = Sql.Database("SER-SQL-01\SQL", "Intact_IQ_Walter_Tipper_Ltd", [Query=";WITH IQAvgCost AS#(lf)(#(lf)    SELECT #(lf)        sub1.C_PRODUCT,#(lf)        SUM(C_NEWSTOCKVALUE) / NULLIF(SUM(C_NEWSTOCKLEVEL), 0) AS C_NEWCOSTPRICE#(lf)    FROM#(lf)    (#(lf)        SELECT #(lf)            ac.C_PRODUCT,#(lf)            ac.C_NEWSTOCKVALUE,#(lf)            ac.C_NEWSTOCKLEVEL,#(lf)            ROW_NUMBER() OVER (#(lf)                PARTITION BY ac.C_PRODUCT, ac.C_BRANCH #(lf)                ORDER BY ac.C_DATE DESC#(lf)            ) AS rn#(lf)        FROM [Intact_IQ_Walter_Tipper_Ltd].[dbo].[T_PRODUCTAVERAGECOSTUPDATE] ac WITH (NOLOCK)#(lf)        WHERE ac.C_BRANCH = 4337992263053#(lf)    ) sub1#(lf)    WHERE rn = 1#(lf)    GROUP BY sub1.C_PRODUCT#(lf)),#(lf)SalesYTD AS#(lf)(#(lf)    SELECT #(lf)        [Product_ID],#(lf)        SUM([Quantity]) AS TotalQty,#(lf)        SUM([NetAmountLessDiscountBase]) AS TotalSales#(lf)    FROM [Intact_IQ_Walter_Tipper_Ltd_Archive].[dbo].[Tippers_SalesAnalysis] WITH (NOLOCK)#(lf)    WHERE [Date] >= DATEADD(YEAR, -1, GETDATE())#(lf)    GROUP BY [Product_ID]#(lf)),#(lf)SupplierPurchasingYTD AS#(lf)(#(lf)    SELECT #(lf)        PDNL.C_PRODUCT AS Product_ID,#(lf)        SUM(PDNL.C_QUANTITYINVOICED) AS QtyInvoiced#(lf)    FROM [Intact_IQ_Walter_Tipper_Ltd].[dbo].[T_PURCHASEDELIVERYNOTE_LINE] PDNL WITH (NOLOCK)#(lf)    INNER JOIN [Intact_IQ_Walter_Tipper_Ltd].[dbo].[T_PURCHASEDELIVERYNOTE] PDN WITH (NOLOCK)#(lf)        ON PDN.C_ID = PDNL.C__OWNER_#(lf)    WHERE PDN.C_DATE >= DATEADD(YEAR, -1, GETDATE())#(lf)    GROUP BY PDNL.C_PRODUCT#(lf)),#(lf)ExchangeRate AS#(lf)(#(lf)    SELECT C_PURCHASELEDGERRATE AS exRate#(lf)    FROM [Intact_IQ_Walter_Tipper_Ltd].[dbo].[T_IS_CURRENCYRATEDEFINITION_CURRENCYRATEDEFINITIONCURRENCYINFO] WITH (NOLOCK)#(lf)    WHERE C_ID = 524883787719020#(lf))#(lf)SELECT#(lf)    p.C_ID AS ProductID,#(lf)    p.C_CODE AS ProdCode,#(lf)    p.C_DESCRIPTION AS ProdDescription,#(lf)    PD.C_DESCRIPTION AS Department,#(lf)#(lf)    CASE p.C_TYPE #(lf)        WHEN 0  THEN 'Standard'#(lf)        WHEN 4  THEN 'Special'#(lf)        WHEN 7  THEN 'Assembly'#(lf)        WHEN 3  THEN 'Kit'#(lf)        WHEN 11 THEN 'Linear'#(lf)        WHEN 12 THEN 'LinearCon'#(lf)        WHEN 21 THEN 'Index'#(lf)        ELSE CAST(p.C_TYPE AS VARCHAR(10)) #(lf)    END AS ProductType,#(lf)#(lf)    s.C_NAME AS SupplierName,#(lf)    s.C_CODE AS SupplierCode,#(lf)#(lf)    CASE p.C_STOCKINGSTATUS #(lf)        WHEN 0 THEN 'Stocked'#(lf)        WHEN 5 THEN 'Discontinued Immediately'#(lf)        WHEN 4 THEN 'Discontinued After Stock Is Sold'#(lf)        WHEN 1 THEN 'Non Stocked'#(lf)        WHEN 7 THEN 'Not Applicable' #(lf)        WHEN 2 THEN 'Superseded'#(lf)        ELSE CAST(p.C_STOCKINGSTATUS AS VARCHAR(10)) #(lf)    END AS StockingStatus,#(lf)#(lf)    p.C_D_SEARCHKEYWORDS AS SearchKeywords,#(lf)    PP.C_SUPPLIERPRODUCTCODE AS SupplierProductCode,#(lf)#(lf)    -- Габариты и объем (CBM)#(lf)    m.C_LENGTH AS Length,#(lf)    m.C_WIDTH AS Width,#(lf)    m.C_HEIGHT AS Height,#(lf)    m.C_GROSSWEIGHT AS GrossWeight,#(lf)    CAST((m.C_LENGTH * m.C_WIDTH * m.C_HEIGHT) / 1000000000.0 AS DECIMAL(18,4)) AS CBM,#(lf)#(lf)    -- Стоковые показатели#(lf)    CONVERT(DOUBLE PRECISION, ISNULL(pstats.C_STOCKLEVEL, 0)) AS StockLevel,#(lf)    CONVERT(DOUBLE PRECISION, ISNULL(pstats.C_OUTSTANDINGSALESORDERS, 0)) AS OutstandingSO,#(lf)    CONVERT(DOUBLE PRECISION, ISNULL(pstats.C_OUTSTANDINGPURCHASEORDERS, 0)) AS OutstandingPO,#(lf)    CONVERT(DOUBLE PRECISION, ISNULL(pstats.C_EFFECTIVESTOCKLEVEL, 0)) AS EffectiveStockLevel,#(lf)#(lf)    -- Данные YTD#(lf)    CAST(ISNULL(Ytd.TotalQty, 0) AS INT) AS SalesYtdQty,#(lf)    CAST(ISNULL(Ytd.TotalSales, 0) AS DECIMAL(18,2)) AS SalesYtdAmount,#(lf)    CONVERT(DOUBLE PRECISION, ISNULL(SPY.QtyInvoiced, 0)) AS QtyPurchasedYtd,#(lf)#(lf)    -- Цены и себестоимость#(lf)    ex.exRate AS ExchangeRateUSD,#(lf)    CAST(PP.C_LISTPRICEACTUAL AS DECIMAL(18,2)) AS ListPriceActual,#(lf)    CAST(CASE WHEN CUR.C_CODE = 'USD' THEN PPalt.C_LISTPRICEACTUAL ELSE 0 END AS DECIMAL(18,2)) AS USDListPrice,#(lf)    ISNULL(comc.C_D_RATE, 0) AS DutyRatePercentage,#(lf)    cc.C_STANDARDCOST AS StandardCost,#(lf)    i.C_NEWCOSTPRICE AS AvgCost,#(lf)#(lf)    -- Расчет Landed Cost#(lf)    CAST(#(lf)        CASE #(lf)            WHEN CUR.C_CODE = 'USD' #(lf)                 AND PPalt.C_LISTPRICEACTUAL IS NOT NULL #(lf)                 AND (m.C_LENGTH * m.C_WIDTH * m.C_HEIGHT) > 0#(lf)                 AND ex.exRate > 0#(lf)            THEN (#(lf)                    (CEILING((PPalt.C_LISTPRICEACTUAL / ex.exRate) * 100) / 100.0) +#(lf)                    (((m.C_LENGTH * m.C_WIDTH * m.C_HEIGHT) / 1000000000.0) / 66.0 * 6000.0)#(lf)                 ) * (1 + ISNULL(comc.C_D_RATE, 0) / 100.0)#(lf)            ELSE i.C_NEWCOSTPRICE#(lf)        END AS DECIMAL(18,2)#(lf)    ) AS CalculatedLandedCost#(lf)#(lf)    ,PP.[C_SUPPLIERPRODUCTCODE] AS 'Aqua I Code'#(lf)    ,PP.[C_SUPPLIERPRODUCTDESCRIPTION] AS 'Aqua I Description'#(lf)    ,P.C_D_WyndamCode AS 'Wyndam Code'#(lf)    ,P.C_D_WyndamDescription AS 'Wyndam Description'#(lf)    ,P.C_ManufacturerProductCode AS 'Supplier Stock Code'#(lf)    ,PP.C_D_MOQ#(lf)#(lf)FROM [Intact_IQ_Walter_Tipper_Ltd].[dbo].[T_PRODUCT] p WITH (NOLOCK)#(lf)CROSS JOIN ExchangeRate ex#(lf)LEFT JOIN [Intact_IQ_Walter_Tipper_Ltd].[dbo].[T_PRODUCT_STATISTICS] pstats WITH (NOLOCK) ON pstats.C_ID = p.C_STATISTICS#(lf)LEFT JOIN [Intact_IQ_Walter_Tipper_Ltd].[dbo].[T_PRODUCT_PURCHASING] pp WITH (NOLOCK) ON pp.C_ID = p.C_PURCHASING#(lf)LEFT JOIN [Intact_IQ_Walter_Tipper_Ltd].[dbo].[T_SUPPLIER] s WITH (NOLOCK) ON s.C_ID = pp.C_DEFAULTSUPPLIER#(lf)LEFT JOIN [Intact_IQ_Walter_Tipper_Ltd].[dbo].[T_PRODUCTDEPARTMENT] PD WITH (NOLOCK) ON PD.C_ID = p.C_DEPARTMENT#(lf)LEFT JOIN [Intact_IQ_Walter_Tipper_Ltd].[dbo].[T_PRODUCTDEPARTMENTGROUP] PDG WITH (NOLOCK) ON PD.C_GROUP = PDG.C_ID#(lf)LEFT JOIN [Intact_IQ_Walter_Tipper_Ltd].[dbo].[T_PRODUCT_COSTINGS] cc WITH (NOLOCK) ON cc.C_ID = p.C_COSTINGS#(lf)LEFT JOIN [Intact_IQ_Walter_Tipper_Ltd].[dbo].[T_PRODUCT_MEASUREMENTS] m WITH (NOLOCK) ON p.C_MEASUREMENTS = m.C_ID#(lf)LEFT JOIN [Intact_IQ_Walter_Tipper_Ltd].[dbo].[T_PRODUCT_ALTERNATEPURCHASINGINFO] PI WITH (NOLOCK) ON PI.C__OWNER_ = p.C_ID#(lf)LEFT JOIN [Intact_IQ_Walter_Tipper_Ltd].[dbo].[T_PRODUCT_PURCHASING] PPAlt WITH (NOLOCK) ON PPAlt.C_ID = PI.C_ID#(lf)LEFT JOIN [Intact_IQ_Walter_Tipper_Ltd].[dbo].[T_CURRENCY] CUR WITH (NOLOCK) ON CUR.C_ID = PPalt.C_LISTPRICECURRENCY#(lf)LEFT JOIN [Intact_IQ_Walter_Tipper_Ltd].[dbo].[T_PRODUCT_IMPORTDUTYSETTINGS] com WITH (NOLOCK) ON com.C_ID = p.C_IMPORTDUTYSETTINGS#(lf)LEFT JOIN [Intact_IQ_Walter_Tipper_Ltd].[dbo].[T_IS_COMMODITYCODE] comc WITH (NOLOCK) ON comc.C_ID = com.C_COMMODITYCODE#(lf)LEFT JOIN IQAvgCost i ON i.C_PRODUCT = p.C_ID#(lf)LEFT JOIN SalesYTD Ytd ON Ytd.Product_ID = p.C_ID#(lf)LEFT JOIN SupplierPurchasingYTD SPY ON SPY.Product_ID = p.C_ID#(lf)WHERE p.C_TYPE NOT IN (15, 2, 6, 19, 10, 18)#(lf)  AND PDG.C_CODE = 'AQUAI';"])
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

