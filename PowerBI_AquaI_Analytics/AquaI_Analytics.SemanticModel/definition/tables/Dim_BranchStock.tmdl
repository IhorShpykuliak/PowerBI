	partition Dim_BranchStock = m
		mode: directQuery
		source =
				let
				    Source = Sql.Database("SER-SQL-01\SQL", "Intact_IQ_Walter_Tipper_Ltd", [Query="SELECT #(lf)    PROD.[C_ID] AS [ProductID]#(lf)    ,B.C_ID AS [BranchID]#(lf)    ,SUM(PBS.[C_STOCKLEVEL]) AS [Stock Level]#(lf)    ,SUM(PBS.[C_FREESTOCKLEVEL]) AS [Free Stock Level]#(lf)  FROM [Intact_IQ_Walter_Tipper_Ltd].[dbo].[T_PRODUCT] PROD #(lf)    LEFT JOIN [Intact_IQ_Walter_Tipper_Ltd].[dbo].[T_PRODUCT_COSTINGS] PC ON PC.C_ID = PROD.C_COSTINGS#(lf)    LEFT JOIN [Intact_IQ_Walter_Tipper_Ltd].[dbo].[T_PRODUCTBRANCHSTATISTICS] PBS ON PBS.C_PRODUCT = PROD.C_ID#(lf)    LEFT JOIN [Intact_IQ_Walter_Tipper_Ltd].[dbo].[T_BRANCH] B ON PBS.C_BRANCH = B.C_ID#(lf)    LEFT JOIN [Intact_IQ_Walter_Tipper_Ltd].[dbo].[T_PRODUCT_PURCHASING] PP ON PP.C_ID = PROD.C_PURCHASING#(lf)    LEFT JOIN [Intact_IQ_Walter_Tipper_Ltd].[dbo].[T_PRODUCT_SELLING] PS ON PS.C_ID = PROD.C_SELLING#(lf)    LEFT JOIN [Intact_IQ_Walter_Tipper_Ltd].[dbo].[T_PRODUCT_SELLING_PRICEDEFINITION] PSD ON PSD.[C__OWNER_]= PS.C_ID and PSD.C_DESCRIPTION = 'Retail'#(lf)    LEFT JOIN [Intact_IQ_Walter_Tipper_Ltd].[dbo].[T_SUPPLIER] S ON PP.C_DEFAULTSUPPLIER = S.C_ID#(lf)    LEFT JOIN [Intact_IQ_Walter_Tipper_Ltd].[dbo].[T_PRODUCTDEPARTMENT] PD WITH (NOLOCK) ON PD.C_ID = PROD.C_DEPARTMENT#(lf)    LEFT JOIN [Intact_IQ_Walter_Tipper_Ltd].[dbo].[T_PRODUCTDEPARTMENTGROUP] PDG WITH (NOLOCK) ON PD.C_GROUP = PDG.C_ID#(lf)    WHERE PBS.[C_STOCKLEVEL] > 0#(lf)      --AND PROD.[C_CODE] = '11113875'#(lf)        --S.C_CODE = '959500' #(lf)        --AND B.C_CODE = 'LICH'#(lf)    AND PDG.C_CODE = 'AQUAI'#(lf)  Group BY PROD.[C_ID],B.C_ID#(lf)      #(lf)          "])
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

