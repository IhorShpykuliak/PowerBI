	partition Dim_Customer = m
		mode: import
		source =
				let
				    Source = Sql.Database("SER-SQL-01\SQL", "Tippers", [Query="SELECT [CustomerID]#(lf)      ,[CustomerCode]#(lf)      ,[CustomerName]#(lf)      ,[CustomerCodeNorm]#(lf)      ,[TradingName]#(lf)      ,[WorkflowStatusID]#(lf)      ,[CreditStatusID]#(lf)      ,[CustomerCategoryID]#(lf)      ,[HomeBranchID]#(lf)      ,[Address]#(lf)      ,[Phone]#(lf)      ,[EmailAddress]#(lf)      ,SalesRepID#(lf)  FROM [Tippers].[dbo].[Dim_Customer]"]),
				    #"Renamed Columns" = Table.RenameColumns(Source,{{"CustomerCode", "CustomerCode"}}),
				    #"Added Custom" = Table.AddColumn(#"Renamed Columns", "Customer Code & Name", each [CustomerCode]& " - " &[CustomerName])
				in
				    #"Added Custom"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

