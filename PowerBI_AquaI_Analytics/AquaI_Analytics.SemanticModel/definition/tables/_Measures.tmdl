	measure Measure
		lineageTag: 72d07a54-e268-4288-97b4-10eb0b646080

		annotation 43dbc3e8-3a1c-4b6f-9923-b49ff7d6691c = True

	measure 'Is Full Month' = ```
			
			VAR t = TODAY()
			RETURN IF ( DAY ( t ) = 1 || ( DAY ( t ) = 2 && WEEKDAY ( t, 2 ) = 1 ), 1, 0 )
			
			```
		formatString: 0
		lineageTag: acd0e630-afcf-48de-b0df-3dbf1968b0ea

	measure 'CY End' = ```
			IF ( [Is Full Month] = 1, EOMONTH ( TODAY (), -1 ), TODAY () - 1 )
			
			```
		formatString: General Date
		lineageTag: fe6bc414-6475-4629-915b-fa139aefe141

	measure 'CY Start' = ```
			DATE ( YEAR ( [CY End] ), MONTH ( [CY End] ), 1 )
			
			```
		formatString: General Date
		lineageTag: 210d5611-1af4-418c-9146-e7cd7fdc53a3

	measure 'LY Start' = ```
			EDATE ( [CY Start], -12 )
			
			```
		formatString: General Date
		lineageTag: c5794e0d-8b3a-44ba-b03a-1fd63e4e82dc

	measure 'LY End' = ```
			IF ( [Is Full Month] = 1, EOMONTH ( [LY Start], 0 ), EDATE ( [CY End], -12 ) )
			
			```
		formatString: General Date
		lineageTag: 838ed550-fe6a-49ce-bd13-d23a8ccf6564

	measure 'CY Year Start' = ```
			DATE ( YEAR ( [CY End] ), 1, 1 )
			
			```
		formatString: General Date
		lineageTag: 355f583e-a07c-4e29-a4e7-37463ad9571d

	measure 'LY Year Start' = ```
			EDATE ( [CY Year Start], -12 )
			
			```
		formatString: General Date
		lineageTag: 153d9705-0c64-43f7-81d2-388c4be0d68d

	measure 'LY YTD End' = EDATE ( [CY End], -12 )
		formatString: General Date
		lineageTag: 2df634ae-64f9-4c0c-81b0-1a0f43f4b443

	measure 'Sales CY MTD' = ```
			
			CALCULATE ( [SalesAI], FILTER ( ALL ( Dim_Date[Date] ), Dim_Date[Date] >= [CY Start] && Dim_Date[Date] <= [CY End] ) )
			
			
			```
