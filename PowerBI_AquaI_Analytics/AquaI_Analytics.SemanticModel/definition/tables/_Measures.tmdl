	measure 'HTML Table Sticky' = ```
			
			VAR _HeaderCode = "
			<style>
			    table {
			        border-collapse: collapse;
			        width: 100%;
			        font-family: Arial, sans-serif;
			        font-size: 12px;
			    }
			    th, td {
			        padding: 8px 12px;
			        border: 1px solid #ddd;
			        text-align: left;
			        white-space: nowrap;
			    }
			    th {
			        background-color: #f2f2f2;
			        position: sticky;
			        top: 0;
			        z-index: 2;
			    }
			    td:nth-child(1), th:nth-child(1) {
			        position: sticky;
			        left: 0;
			        background-color: #ffffff;
			        z-index: 1;
			    }
			    td:nth-child(2), th:nth-child(2) {
			        position: sticky;
			        left: 100px;
			        background-color: #ffffff;
			        z-index: 1;
			    }
			</style>
			<table>
			    <thead>
			        <tr>
			            <th>Product Code</th>
			            <th>Selected Metric Value</th>
			        </tr>
			    </thead>
			    <tbody>
			"
			
			VAR _Rows = 
			    CONCATENATEX(
			        VALUES('Dim_Product'[ProdCode]),
			        VAR _SelectedMetric = SELECTEDVALUE('Dynamic Product Information'[Dynamic Product Info])
			        VAR _Val = 
			            SWITCH(
			                _SelectedMetric,
			                "SupplierCode", COALESCE(SELECTEDVALUE('Dim_Product'[SupplierCode]), ""),
			                "SupplierName", COALESCE(SELECTEDVALUE('Dim_Product'[SupplierName]), ""),
			                "Stocking Status", COALESCE(SELECTEDVALUE('Dim_Product'[StockingStatus]), ""),
			                "USDListPrice", FORMAT(SELECTEDVALUE('Dim_Product'[USDListPrice]), "General Number"),
			                "List Price Actual", FORMAT(SELECTEDVALUE('Dim_Product'[ListPriceActual]), "General Number"),
			                "Calculated Landed Cost", FORMAT(SELECTEDVALUE('Dim_Product'[CalculatedLandedCost]), "General Number"),
			                "MOQ", FORMAT(SELECTEDVALUE('Dim_Product'[MOQ]), "General Number"),
			                "Pack Size", FORMAT(SELECTEDVALUE('Dim_Product'[PackSize]), "General Number"),
			                "CBM", FORMAT(SELECTEDVALUE('Dim_Product'[CBM]), "General Number"),
			                "Growth Factor", FORMAT(SELECTEDVALUE('Dim_Product'[GrowthFactor]), "General Number"),
			                "Required Months Stock", FORMAT([Required Months Stock], "General Number"),
			                "Ideal Stocking Level", FORMAT([Ideal Stocking Level], "General Number"),
			                "Current Space Requirements CBM", FORMAT([Current Space Requirements CBM], "General Number"),
			                "Ideal Space Requirements", FORMAT([Ideal Space Requirements], "General Number"),
			                "Monthly AVG Sales QTY (6 months)", FORMAT([Monthly Average Sales for 6 month period], "General Number"),
			                "Outstanding PO", FORMAT(SELECTEDVALUE('Dim_Product'[OutstandingPO]), "General Number"),
			                "Stock Level", FORMAT(SELECTEDVALUE('Dim_Product'[StockLevel]), "General Number"),
			                "-"
			            )
			        RETURN
			        "<tr>
			            <td>" & 'Dim_Product'[ProdCode] & "</td>
			            <td>" & _Val & "</td>
			         </tr>",
			        ""
			    )
			
			VAR _FooterCode = "</tbody></table>"
			
			RETURN
			IF(
			    ISBLANK(_Rows),
			    "<div style='padding: 10px; font-family: Arial;'>No data for selected filters</div>",
			    _HeaderCode & _Rows & _FooterCode
			)
			```
		lineageTag: 8810d653-c549-4cdb-b6b9-16fea8ae48ab

