	measure 'Ordered Stock M4' = ```
			
			VAR TargetDate = EDATE(TODAY(), 4) -- shift X month
			    VAR StartOfMon = DATE(YEAR(TargetDate), MONTH(TargetDate), 1)
			    VAR EndOfMon = EOMONTH(TargetDate, 0)
			    VAR Result = 
			        CALCULATE(
			            SUM(Fact_PurchaseOrder[Qty Outstanding]),
			            'Fact_PurchaseOrder'[EffectiveDueDate] >= StartOfMon,
			            'Fact_PurchaseOrder'[EffectiveDueDate] <= EndOfMon
			        )
			RETURN
			    COALESCE(Result, 0)
			```
		lineageTag: bff3559e-1e87-4d02-a20e-74ea11639f6e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

