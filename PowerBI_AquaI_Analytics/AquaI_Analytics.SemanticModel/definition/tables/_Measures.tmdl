table _Measures
	lineageTag: 3927fa90-3c9c-455f-a8c4-6da16e4bdac2

	measure 'Sales YTD Qty' =
			
			CALCULATE (
			    SUM ( Fact_SalesOrder[Quantity Ordered] ),
			    DATESYTD ( Dim_Date[Date] )
			)
		lineageTag: 2b2f8eb7-66c5-4844-89a6-87752cafb2f8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'AQUAI Avg Monthly Sales' =
			
			DIVIDE ( SUM ( Dim_Product[SalesYtdQty] ), 12, 0 )
		lineageTag: f4d7594a-01d0-4bb4-92d3-0a77cd72ed9f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Current Space Requirements CBM' =
			
			SUM('Dim_Product'[StockLevel]) * SELECTEDVALUE('Dim_Product'[CBM])
		lineageTag: 4a087a9e-a53f-450a-9495-0f96a046822f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Forecast Orders Outstanding QTY Total' =
			
			COALESCE(
			    CALCULATE(
			        SUM('Fact_SalesOrder'[Quantity Outstanding]),
			        KEEPFILTERS('Dim_OrderType'[C_DESCRIPTION] = "7. Forecast Order")
			    ),
			    0
			)
		lineageTag: ea4261be-0dea-425c-946c-e1e99f453c95

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ideal Space Requirements' =
			
			[Ideal Stocking Level] * SELECTEDVALUE('Dim_Product'[CBM])
		lineageTag: 35d122b9-3417-4f7d-903e-065140bbb688

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ideal Stocking Level' = [Monthly Average Sales for 6 month period] * [Required Months Stock]
		lineageTag: 907fe47f-f71e-4b36-868d-b92962ac0f38

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Required Months Stock' = ```
			
			VAR MonthsForCore = 3      --  Core 
			VAR MonthsForNonCore = 1   --  Non-core 
			RETURN
			    IF(
			        SELECTEDVALUE('Dim_Product'[CoreProduct]) = TRUE, 
			        MonthsForCore, 
			        MonthsForNonCore
			    )
			```
		formatString: 0
		lineageTag: e4bd71d0-016a-48f6-b99d-98614e6d1d77

	measure 'Monthly Average Sales for 6 month period' = ```
			
			VAR MaxDate = CALCULATE(MAX('Fact_SalesAnalysis'[SalesDateKey]), REMOVEFILTERS())
			VAR StartDate = EDATE(MaxDate, -6)
			VAR PeriodSales = 
			    CALCULATE(
			        SUM('Fact_SalesAnalysis'[QuantitySold]),
			        'Dim_Date'[Date] > StartDate && 'Dim_Date'[Date] <= MaxDate,
			        KEEPFILTERS('Fact_SalesAnalysis'[SalesOrderType] <> "7. Forecast Order")
			    )
			RETURN
			    COALESCE(PeriodSales / 6, 0)
			```
		lineageTag: c37ad331-1180-4b85-b823-70c988e18ac0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Months Stock Remaining inc FO + 0' = ```
			
			DIVIDE(
			    SUM('Dim_Product'[StockLevel]) - [Forecast Orders Outstanding QTY (M+0)],
			    [Monthly Average Sales for 6 month period]
			    
			)
			```
		lineageTag: f7936c85-ed2f-4deb-9a07-1cde79241a61

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ordered Stock context' = ```
			
			CALCULATE(
			    SUM(Fact_PurchaseOrder[Qty Outstanding]),
			    DATESBETWEEN(
			        'Dim_Date'[Date], 
			        MIN('Dim_Date'[Date]), 
			        MAX('Dim_Date'[Date])
			    )
			)
			```
		lineageTag: 53f31d78-4fd6-4883-a6ba-f2553592072e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Forecasted Sales Total' = ```
			
			([Monthly Average Sales for 6 month period] * SELECTEDVALUE('Dim_Product'[GrowthFactor], 1)) 
			+ [Forecast Orders Outstanding QTY Total]
			```
		lineageTag: 9751013f-2ea9-40f1-a5f5-939418b6ece6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Suggested Order Amount M0' =
			
			VAR RawQty = [Ideal Stocking Level] - [Predicted Stock M0]
			VAR MOQ = SELECTEDVALUE('Dim_Product'[MOQ], 0)
			VAR PackSize = SELECTEDVALUE('Dim_Product'[PackSize], 1)
			RETURN
			    IF(
			        RawQty < MOQ,
			        0,
			        CEILING(RawQty / PackSize, 1) * PackSize
			    )
		lineageTag: a0a80868-a83c-4c5a-add3-41044224abca

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Predicted Stock M1' = ```
			
			    ( SUM('Dim_Product'[StockLevel]) - [Forecasted Sales M1] ) + [Ordered Stock M1]
			```
		lineageTag: fa4e1b4c-d023-4390-980b-f627f1c94fc5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Months Stock Remaining inc FO + 1' =
			
			DIVIDE(
			    [Predicted Stock M1] - [Forecast Orders Outstanding QTY (M+0)] - [Forecast Orders Outstanding QTY (M+1)],
			    [Monthly Average Sales for 6 month period],
			    0
			)
		lineageTag: 7a699889-befc-46b0-b582-fb89e02d5c20

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Suggested Order Amount M1' =
			
			VAR RawQty = [Ideal Stocking Level] - [Predicted Stock M1]
			VAR MOQ = SELECTEDVALUE('Dim_Product'[MOQ], 0)
			VAR PackSize = SELECTEDVALUE('Dim_Product'[PackSize], 1)
			RETURN
			    IF(
			        RawQty < MOQ,
			        0,
			        CEILING(RawQty / PackSize, 1) * PackSize
			    )
		lineageTag: 581b5a43-3a97-480f-8d1e-1b34e9924a65

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Container Total Value' =
			
			SUMX(
			    'Dim_Product',
			    [Suggested Order Amount M0] * 'Dim_Product'[ListPriceActual]
			)
		lineageTag: ceb7b5a5-92ad-475e-b247-52d6c1076d91

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Container Total CBM' =
			
			SUMX(
			    'Dim_Product',
			    [Suggested Order Amount M0] * 'Dim_Product'[CBM]
			)
		lineageTag: 99dbd817-10f6-42bc-a76c-afdb167ec4d5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Forecast Qty Ordered Standard' =
			
			CALCULATE(
			    SUM(Fact_SalesOrder[Quantity Ordered]),
			    Fact_SalesOrder[IsKit] = 0,
			    KEEPFILTERS(Dim_OrderType[C_DESCRIPTION] = "7. Forecast Order")
			)
		lineageTag: 2e874a25-6bc9-4f31-acc1-b61088171d71

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Forecast Qty Outstanding Standard' =
			
			CALCULATE(
			    SUM(Fact_SalesOrder[Quantity Outstanding]),
			    Fact_SalesOrder[IsKit] = 0,
			    KEEPFILTERS(Dim_OrderType[C_DESCRIPTION] = "7. Forecast Order")
			)
		lineageTag: eca85336-b0ef-44ad-8002-64de4d828704

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Orders Outstanding QTY' =
			
			COALESCE(
			    CALCULATE(
			        SUM('Fact_SalesOrder'[Quantity Outstanding]),
			        KEEPFILTERS('Dim_OrderType'[C_DESCRIPTION] <> "7. Forecast Order")
			    ),
			    0
			)
		lineageTag: bdc7a078-13de-4736-9d0c-aa8181d0dfc0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Color Measure' = ```
			
			VAR sel = SELECTEDVALUE ( 'Dynamic Product Label Selector'[Dynamic Product Label Selector] )
			RETURN
			SWITCH (
			    TRUE (),
			    sel = 0, "#FFE699",   
			    sel = 1, "#C6E0B4",
			    sel = 2, "#BDD7EE",
			    "#FFFFFF"
			)
			```
		formatString: 0
		lineageTag: a1df77bf-a5c8-416e-ac3a-56ce53dc7ce2

	measure 'Forecast Orders Outstanding QTY (M+0)' =
			
			VAR StartDate = DATE(YEAR(TODAY()), MONTH(TODAY()), 1)
			VAR EndDate = EOMONTH(TODAY(), 0)
			RETURN
			COALESCE(
			    CALCULATE(
			        SUM('Fact_SalesOrder'[Quantity Outstanding]),
			        'Dim_OrderType'[C_DESCRIPTION] = "7. Forecast Order",
			        'Fact_SalesOrder'[LineDueDate] >= StartDate,
			        'Fact_SalesOrder'[LineDueDate] <= EndDate
			    ),
			    0
			)
		lineageTag: 6bfdc54a-49f8-4338-891e-6584939a760b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Forecast Orders Outstanding QTY (M+1)' =
			
			VAR TargetDate = EDATE(TODAY(), 1)
			RETURN
			COALESCE(
			    CALCULATE(
			        SUM('Fact_SalesOrder'[Quantity Outstanding]),
			        'Dim_OrderType'[C_DESCRIPTION] = "7. Forecast Order",
			        'Dim_Date'[Year] = YEAR(TargetDate),
			        'Dim_Date'[MonthNumber] = MONTH(TargetDate)
			    ),
			    0
			)
		lineageTag: c7477ed0-6e90-46b5-aee1-ba3a0fc1d826

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Forecast Orders Outstanding QTY (M+2)' =
			
			VAR TargetDate = EDATE(TODAY(), 2)
			RETURN
			COALESCE(
			    CALCULATE(
			        SUM('Fact_SalesOrder'[Quantity Outstanding]),
			        'Dim_OrderType'[C_DESCRIPTION] = "7. Forecast Order",
			        'Dim_Date'[Year] = YEAR(TargetDate),
			        'Dim_Date'[MonthNumber] = MONTH(TargetDate)
			    ),
			    0
			)
		lineageTag: d76156b2-a944-43b3-9e97-faf6b0afecbb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Months Stock Remaining inc FO + 2' =
			
			DIVIDE(
			    [Predicted Stock M1] - [Forecast Orders Outstanding QTY (M+0)] - [Forecast Orders Outstanding QTY (M+1)] - [Forecast Orders Outstanding QTY (M+2)],
			    [Monthly Average Sales for 6 month period],
			    0
			)
		lineageTag: d559b7c9-437b-4278-9e19-baa1143e745a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Forecast Orders Outstanding QTY (M+3)' =
			
