	measure 'Suggested Order Amount M2' =
			
			VAR RawQty = [Ideal Stocking Level] - [Predicted Stock M2]
			VAR MOQ = SELECTEDVALUE('Dim_Product'[MOQ], 0)
			VAR PackSize = SELECTEDVALUE('Dim_Product'[PackSize], 1)
			RETURN
