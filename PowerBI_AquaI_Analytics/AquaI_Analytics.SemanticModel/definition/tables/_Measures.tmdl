	measure 'Forecasted Sales M4' = ```
			
			    VAR PrevMonth = [Forecasted Sales M3]
			    VAR Growth = SELECTEDVALUE('Dim_Product'[GrowthFactor], 1)
			RETURN
			    PrevMonth * (1 + (Growth/100))
