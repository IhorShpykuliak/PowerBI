	measure 'Months Stock Remaining inc FO + 3' =
			
			DIVIDE(
			    [Predicted Stock M1] - [Forecast Orders Outstanding QTY (M+0)] - [Forecast Orders Outstanding QTY (M+1)] - [Forecast Orders Outstanding QTY (M+2)]- [Forecast Orders Outstanding QTY (M+4)],
