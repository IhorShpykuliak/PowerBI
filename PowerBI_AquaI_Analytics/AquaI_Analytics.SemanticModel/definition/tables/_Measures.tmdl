	measure 'Color Measure' = ```
			
			VAR sel = SELECTEDVALUE ( 'Dynamic Product Label Selector'[Dynamic Product Label Selector] )
			RETURN
			SWITCH (
			    TRUE (),
			    sel = 0, "#FFE699",   
			    sel = 1, "#C6E0B4",
			    sel = 2, "#BDD7EE",
			    "#FFFFFF"
			)
			```
		formatString: 0
		lineageTag: a1df77bf-a5c8-416e-ac3a-56ce53dc7ce2

	measure 'Forecast Orders Outstanding QTY (M+0)' =
			
			VAR StartDate = DATE(YEAR(TODAY()), MONTH(TODAY()), 1)
			VAR EndDate = EOMONTH(TODAY(), 0)
			RETURN
			COALESCE(
			    CALCULATE(
			        SUM('Fact_SalesOrder'[Quantity Outstanding]),
			        'Dim_OrderType'[C_DESCRIPTION] = "7. Forecast Order",
			        'Fact_SalesOrder'[EffectiveDueDate] >= StartDate,
			        'Fact_SalesOrder'[EffectiveDueDate] <= EndDate
			    ),
			    0
			)
		lineageTag: 6bfdc54a-49f8-4338-891e-6584939a760b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Forecast Orders Outstanding QTY (M+1)' =
			
			VAR StartDate = EOMONTH(TODAY(), 0) + 1  -- last day current month + 1 day = 1st next month
			VAR EndDate = EOMONTH(TODAY(), 1)        -- last day next month
			RETURN
			COALESCE(
			    CALCULATE(
			        SUM('Fact_SalesOrder'[Quantity Outstanding]),
			        'Dim_OrderType'[C_DESCRIPTION] = "7. Forecast Order",
			        'Fact_SalesOrder'[EffectiveDueDate] >= StartDate,
			        'Fact_SalesOrder'[EffectiveDueDate] <= EndDate
			    ),
			    0
			)
		lineageTag: c7477ed0-6e90-46b5-aee1-ba3a0fc1d826

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Forecast Orders Outstanding QTY (M+2)' =
			
			VAR StartDate = EOMONTH(TODAY(), 1) + 1  -- First day of the M+2 month (day after the end of M+1)
			VAR EndDate = EOMONTH(TODAY(), 2)        -- Last day of the M+2 month
			RETURN
			COALESCE(
			    CALCULATE(
			        SUM('Fact_SalesOrder'[Quantity Outstanding]),
			        'Dim_OrderType'[C_DESCRIPTION] = "7. Forecast Order",
