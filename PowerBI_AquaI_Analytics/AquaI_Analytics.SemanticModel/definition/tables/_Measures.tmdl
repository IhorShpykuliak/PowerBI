		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Forecast Orders Outstanding QTY (M+7)' =
			
			VAR StartDate = EOMONTH(TODAY(), 6) + 1  -- First day of the M+7 month (day after the end of M+1)
			VAR EndDate = EOMONTH(TODAY(), 7)        -- Last day of the M+7 month
			RETURN
			COALESCE(
			    CALCULATE(
			        SUM('Fact_SalesOrder'[Quantity Outstanding]),
			        'Dim_OrderType'[C_DESCRIPTION] = "7. Forecast Order",
			        'Fact_SalesOrder'[EffectiveDueDate] >= StartDate,
			        'Fact_SalesOrder'[EffectiveDueDate] <= EndDate
			    ),
			    0
			)
		lineageTag: 4c051b04-3377-450c-833c-6a09a2459230

		annotation PBI_FormatHint = {"isGeneralNumber":true}

