table Fact_PurchaseOrder
	lineageTag: 3dfee5e6-3012-4299-9c1c-85c7fe1c81fb

	refreshPolicy
		policyType: basic
		rollingWindowGranularity: year
		rollingWindowPeriods: 3
		incrementalGranularity: day
		incrementalPeriods: 30
		sourceExpression =
			let
			    Source = Sql.Database("SER-SQL-01\SQL", "Intact_IQ_Walter_Tipper_Ltd", [Query="SELECT #(lf)    -- Primary & Foreign Keys for Star Schema Relationships#(lf)    PO.C_ID                                AS PurchaseOrderID,#(lf)    POL.C_ID                               AS POLineID,#(lf)    CAST(PO.C_DATE AS DATE)                AS PODateKey,        -- Foreign key to Dim_Date#(lf)    PO.C_SUPPLIER                          AS SupplierID,       -- Foreign key to Dim_Supplier / Dim_Customer#(lf)    POL.C_PRODUCT                          AS ProductID,        -- Foreign key to Dim_Product#(lf)    PO.C_WORKFLOWSTATUS                    AS StatusID,         -- Foreign key to Dim_Status (if applicable)#(lf)    #(lf)    -- Purchase Order Header Attributes#(lf)    PO.C_NUMBER                            AS PONumber,#(lf)    #(lf)    -- Line Quantities#(lf)    ISNULL(POL.C_QUANTITY, 0)              AS QtyOrdered,#(lf)    ISNULL(POL.C_QUANTITYSUPPLIED, 0)      AS QtySupplied,#(lf)    ISNULL(POL.C_QUANTITYOUTSTANDING, 0)   AS QtyOutstanding,#(lf)    ISNULL(POL.C_QUANTITYWRITTENOFF, 0)    AS QtyWrittenOff,#(lf)    ISNULL(POL.C_PACKQUANTITY, 0)          AS PackQuantity,#(lf)    #(lf)    -- Line Amounts#(lf)    ISNULL(POL.C_NETAMOUNTLESSDISCOUNTBASE, 0) AS NetAmount,#(lf)    #(lf)    -- Calculated Financial Metrics (Outstanding Amount)#(lf)    CASE #(lf)        WHEN ISNULL(POL.C_QUANTITY, 0) > 0 #(lf)        THEN (ISNULL(POL.C_NETAMOUNTLESSDISCOUNTBASE, 0) / POL.C_QUANTITY) * ISNULL(POL.C_QUANTITYOUTSTANDING, 0)#(lf)        ELSE 0 #(lf)    END                                    AS OutstandingAmount#(lf)#(lf)FROM [Intact_IQ_Walter_Tipper_Ltd].[dbo].[T_PURCHASEORDER] PO WITH (NOLOCK)#(lf)INNER JOIN [Intact_IQ_Walter_Tipper_Ltd].[dbo].[T_PURCHASEORDER_LINE] POL WITH (NOLOCK)#(lf)    ON POL.C__OWNER_ = PO.C_ID#(lf)INNER JOIN [Intact_IQ_Walter_Tipper_Ltd].[dbo].[T_PRODUCT] P WITH (NOLOCK)#(lf)    ON P.C_ID = POL.C_PRODUCT#(lf)INNER JOIN [Intact_IQ_Walter_Tipper_Ltd].[dbo].[T_PRODUCTDEPARTMENT] PD WITH (NOLOCK)#(lf)    ON PD.C_ID = P.C_DEPARTMENT#(lf)INNER JOIN [Intact_IQ_Walter_Tipper_Ltd].[dbo].[T_PRODUCTDEPARTMENTGROUP] PDG WITH (NOLOCK)#(lf)    ON PD.C_GROUP = PDG.C_ID#(lf)WHERE 1=1 #(lf)    AND PDG.C_CODE = 'AQUAI'#(lf)    AND P.C_ID != 21479144630299 -- Exclude system/text item 'TEXT HAS DEPARTMENT GROUP AQUA I'#(lf)    AND PO.C_DATE >= '2026-01-01'"]),
			    #"Filtered Rows" = Table.SelectRows(Source, each [PODateKey] >= RangeStart and [PODateKey] < RangeEnd)
			in
			    #"Filtered Rows"

