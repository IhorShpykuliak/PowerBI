ARTMENT] PD WITH (NOLOCK)#(lf)    ON PD.C_ID = P.C_DEPARTMENT#(lf)INNER JOIN [Intact_IQ_Walter_Tipper_Ltd].[dbo].[T_PRODUCTDEPARTMENTGROUP] PDG WITH (NOLOCK)#(lf)    ON PD.C_GROUP = PDG.C_ID#(lf)WHERE 1=1 #(lf)    AND PDG.C_CODE = 'AQUAI'#(lf)    AND P.C_ID != 21479144630299 -- Exclude system/text item 'TEXT HAS DEPARTMENT GROUP AQUA I'#(lf)    AND PO.C_DATE >= '2026-01-01'"]),
